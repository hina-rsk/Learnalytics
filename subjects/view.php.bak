                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1" style="color: #1e3a8a;"><i class="fas fa-question-circle me-2" style="color: #8b5cf6;"></i> <?php echo htmlspecialchars($quiz['title']); ?></h6>
                                            <small class="text-muted">Quiz</small>
                                        </div>
                                    </a>
                                <?php endforeach; ?>
