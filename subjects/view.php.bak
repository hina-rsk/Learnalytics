                                                </a>
                                            </td>
                                            <td><?= htmlspecialchars($student['email']) ?></td>
                                            <td><?= date('M d, Y', strtotime($student['enrolled_at'])) ?></td>
                                        </tr>
                                    <?php endforeach; ?>
                                </tbody>
                            </table>
                        </div>
                    <?php endif; ?>
                </div>
            </div>
        </div>
    </div>
</main>

