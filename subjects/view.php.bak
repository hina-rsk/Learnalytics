                            } catch (PDOException $e) {
                                $stmt = $pdo->prepare("SELECT * FROM lessons WHERE subject_id = ? ORDER BY created_at ASC");
                                $stmt->execute([$subject_id]);
                                $lessons = $stmt->fetchAll();
                            }

                            $groupedLessons = [];
                            foreach ($lessons as $lesson) {
                                $tKey = !empty($lesson['topic']) ? $lesson['topic'] : 'General Topics';
                                $groupedLessons[$tKey][] = $lesson;
                            }
                            ?>
                            <?php if (empty($groupedLessons)): ?>
                                <div class="list-group shadow-sm">
                                    <div class="list-group-item border-0 py-4 text-center text-muted">No lessons available yet.</div>
                                </div>
                            <?php else: ?>
                                <div class="d-flex flex-column gap-3">
                                    <?php foreach ($groupedLessons as $topicName => $tLessons): ?>
                                        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                                            <div class="card-header border-0 d-flex align-items-center justify-content-between py-2 px-3" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);">
                                                <div class="fw-bold" style="color: #1e3a8a; font-size: 0.92rem;">
