<?php
session_start();
require_once '../config/database.php';

if (!isset($_SESSION['user_id'])) {
    header("Location: ../auth/login.php");
    exit;
}

$subject_id = $_GET['id'] ?? 0;
$user_id = $_SESSION['user_id'];
$role = $_SESSION['user_role'];
$error = '';

// Fetch Subject details
$stmt = $pdo->prepare("SELECT c.*, u.name as instructor_name, u.email as instructor_email,
    p.name as program_name, d.name as department_name, s.name as section_name,
    ay.name as academic_year_name
FROM subjects c
LEFT JOIN users u ON c.instructor_id = u.id
LEFT JOIN programs p ON c.program_id = p.id
LEFT JOIN departments d ON c.department_id = d.id
LEFT JOIN sections s ON c.section_id = s.id
LEFT JOIN academic_years ay ON s.academic_year_id = ay.id
WHERE c.id = ?");
$stmt->execute([$subject_id]);
$subject = $stmt->fetch();

if (!$subject) {
    die("Subject not found.");
}

if ($role === 'instructor' && (int)$subject['instructor_id'] !== (int)$user_id) {
    http_response_code(403);
    exit('You can only view courses assigned to you.');
}
if ($role === 'dean') {
    $stmt = $pdo->prepare("SELECT department_id FROM users WHERE id = ? AND role = 'dean'");
    $stmt->execute([$user_id]);
    $deanDepartmentId = (int)$stmt->fetchColumn();
    if ($deanDepartmentId < 1 || (int)$subject['department_id'] !== $deanDepartmentId) {
        http_response_code(403);
        exit('You can only view courses belonging to your department.');
    }
}

// Check enrollment for students
$is_enrolled = false;
if ($role === 'student') {
    $stmt = $pdo->prepare("SELECT id FROM enrollments WHERE student_id = ? AND subject_id = ?");
    $stmt->execute([$user_id, $subject_id]);
    $is_enrolled = $stmt->fetch() ? true : false;
}

// Fetch enrolled students for instructor/admin
$enrolledStudents = [];
if (in_array($role, ['admin', 'instructor', 'dean'])) {
    $stmt = $pdo->prepare("SELECT u.id, u.name, u.email, e.enrolled_at FROM enrollments e JOIN users u ON e.student_id = u.id WHERE e.subject_id = ? ORDER BY e.enrolled_at DESC");
    $stmt->execute([$subject_id]);
    $enrolledStudents = $stmt->fetchAll();
}

// Handle Enrollment
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['enroll'])) {
    if ($subject['status'] === 'archived') {
        $error = 'Cannot enroll in an archived class.';
    } else {
        $stmt = $pdo->prepare("INSERT INTO enrollments (student_id, subject_id) VALUES (?, ?)");
        $stmt->execute([$user_id, $subject_id]);
        header("Location: view.php?id=$subject_id");
        exit;
    }
}

include '../includes/header.php';
include '../includes/sidebar.php';
?>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 pt-4">
    <div class="subject-header">
        <h1 class="subject-page-title"><?php echo htmlspecialchars($subject['title']); ?></h1>

        <div class="subject-header-actions">
            <?php if ($role === 'student' && !$is_enrolled && $subject['status'] !== 'archived'): ?>
                <form method="POST">
                    <button type="submit" name="enroll" class="btn btn-sm subject-action-btn"><i class="fas fa-plus me-1"></i> Enroll in Subject</button>
                </form>
            <?php elseif ($role === 'student' && !$is_enrolled && $subject['status'] === 'archived'): ?>
                <span class="badge subject-status-badge archived"><i class="fas fa-archive me-1"></i> Archived</span>
            <?php elseif ($role === 'student' && $is_enrolled): ?>
                <span class="badge subject-status-badge active"><i class="fas fa-check me-1"></i> Enrolled</span>
            <?php elseif ($role === 'instructor' && $subject['instructor_id'] == $user_id): ?>
                <a href="edit.php?id=<?php echo $subject_id; ?>" class="btn btn-sm subject-action-btn light"><i class="fas fa-edit me-1"></i> Edit Subject</a>
            <?php endif; ?>
        </div>
    </div>

    <?php if ($error): ?>
        <div class="alert alert-danger" style="background-color: #fee2e2; color: #991b1b; border-color: #fca5a5;">
            <?php echo htmlspecialchars($error); ?>
        </div>
    <?php endif; ?>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow border-0 mb-4 course-content subject-description-card">
                <div class="card-header card-header-custom">
                    <h5 class="card-title mb-0">Subject Description</h5>
                </div>
                <div class="card-body">
                    <p class="card-text"><?php echo nl2br(htmlspecialchars($subject['description'])); ?></p>
                    <p class="card-text small text-muted"><i class="fas fa-user-tie me-2" style="color: #2563eb;"></i><strong>Instructor:</strong> <?php echo htmlspecialchars($subject['instructor_name']); ?></p>
                    <?php if (!empty($subject['class_code']) || !empty($subject['status'])): ?>
                        <p class="card-text small text-muted mt-2">
                            <?php if (!empty($subject['class_code'])): ?>
                                <i class="fas fa-code me-2" style="color: #2563eb;"></i>
                                <strong>Class Code:</strong> 
                                <span class="badge bg-primary fs-6"><?php echo htmlspecialchars($subject['class_code']); ?></span>
                                <small class="text-muted ms-2">(Share this code with students to join)</small>
                            <?php endif; ?>
                            <?php if (!empty($subject['status'])): ?>
                                <span class="badge text-white fs-6 ms-2" style="background: <?php echo $subject['status'] === 'archived' ? '#6b7280' : ($subject['status'] === 'draft' ? '#64748b' : '#10b981'); ?>;">
                                    <?php echo ucfirst(htmlspecialchars($subject['status'])); ?>
                                </span>
                            <?php endif; ?>
                        </p>
                    <?php endif; ?>
                    <?php if (!empty($subject['program_name']) || !empty($subject['department_name']) || !empty($subject['section_name']) || !empty($subject['academic_year_name'])): ?>
                        <div class="subject-meta-grid mt-3">
                            <?php if (!empty($subject['program_name'])): ?>
                                <div>
                                    <span class="text-muted small"><strong>Program:</strong> <?php echo htmlspecialchars($subject['program_name']); ?></span>
                                </div>
                            <?php endif; ?>
                            <?php if (!empty($subject['department_name'])): ?>
                                <div>
                                    <span class="text-muted small"><strong>Department:</strong> <?php echo htmlspecialchars($subject['department_name']); ?></span>
                                </div>
                            <?php endif; ?>
                            <?php if (!empty($subject['section_name'])): ?>
                                <div>
                                    <span class="text-muted small"><strong>Section:</strong> <?php echo htmlspecialchars($subject['section_name']); ?></span>
                                </div>
                            <?php endif; ?>
                            <?php if (!empty($subject['academic_year_name'])): ?>
                                <div>
                                    <span class="text-muted small"><strong>Academic Year:</strong> <?php echo htmlspecialchars($subject['academic_year_name']); ?></span>
                                </div>
                            <?php endif; ?>
                        </div>
                    <?php endif; ?>
                </div>
            </div>

            <!-- Tabbed Interface -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header card-header-custom">
                    <h5 class="card-title mb-0">Course Content</h5>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs mb-4" id="courseTabs" role="tablist" style="border-bottom: 2px solid #2563eb;">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="lessons-tab" data-bs-toggle="tab" data-bs-target="#lessons" type="button" role="tab" aria-controls="lessons" aria-selected="true" style="color: #1e3a8a; border: none; font-weight: 600;">Lessons</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="assignments-tab" data-bs-toggle="tab" data-bs-target="#assignments" type="button" role="tab" aria-controls="assignments" aria-selected="false" style="color: #1e3a8a; border: none;">Assignments</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="quizzes-tab" data-bs-toggle="tab" data-bs-target="#quizzes" type="button" role="tab" aria-controls="quizzes" aria-selected="false" style="color: #1e3a8a; border: none;">Quizzes</button>
